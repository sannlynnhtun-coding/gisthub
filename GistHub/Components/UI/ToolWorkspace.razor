@implements IDisposable
@inject ToolDraftStore Drafts

<NavigationLock OnBeforeInternalNavigation="BeforeNavigationAsync" />

@if (ActiveTool is not null)
{
    <PageTitle>@ActiveTool · GistHub</PageTitle>
}
@if (ActiveTool is { } name && Pages.ContainsKey(name))
{
    <div @key="name" class="tool-workspace-session">
        <section class="tool-workspace"
                 aria-labelledby="@($"tool-page-title-{Pages[name].Component.Name}")" tabindex="-1"
                 data-tool-name="@name">
            <header class="tool-page-header">
                <button @ref="BackButton" type="button" @onclick="() => OnBack.InvokeAsync()" aria-label="@($"Back from {name}")" title="Back">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 5-7 7 7 7M5 12h14"/></svg>
                </button>
                <h2 id="@($"tool-page-title-{Pages[name].Component.Name}")">@name</h2>
                <ToolHelp Name="@name" />
            </header>
            @if (SaveError is not null) { <p role="alert">@SaveError</p> }
            <div class="tool-page-content">
                <CascadingValue Name="IsToolWorkspace" Value="true">
                    <CascadingValue Name="OpenWorkbenchTool" Value="OnOpenWorkbenchTool">
                        <DynamicComponent @ref="ToolComponent" Type="Pages[name].Component" />
                    </CascadingValue>
                </CascadingValue>
            </div>
        </section>
    </div>
}

@code {
    public static readonly IReadOnlyDictionary<string, (Type Component, string Route)> Pages =
        new Dictionary<string, (Type, string)>
        {
            ["AI Tools & Skills"] = (typeof(GistHub.Pages.AgentSkills), "agent-skills"),
            ["Tools Guide"] = (typeof(GistHub.Pages.Tools), "tools"),
            ["Password Generator"] = (typeof(GistHub.Pages.PasswordGenerator), "tools/password-generator"),
            ["Cron Expression"] = (typeof(GistHub.Pages.CronExpression), "tools/cron-expression"),
            ["Markdown Live Preview"] = (typeof(GistHub.Pages.MarkdownLivePreview), "tools/markdown-live-preview"),
            ["Markdown to DOCX"] = (typeof(GistHub.Pages.MarkdownToDocx), "tools/markdown-to-docx"),
            ["Markdown converters"] = (typeof(GistHub.Pages.MarkdownConverters), "tools/markdown-converters"),
            ["Markdown to Text"] = (typeof(GistHub.Pages.MarkdownToText), "tools/markdown-to-text"),
            ["Markdown to Cards"] = (typeof(GistHub.Pages.MarkdownToCards), "tools/markdown-to-cards"),
            ["draw.io Diagram Editor"] = (typeof(GistHub.Pages.DiagramEditor), "tools/diagram-editor"),
            ["Mermaid to Image"] = (typeof(GistHub.Pages.MermaidToImage), "tools/mermaid-to-image"),
            ["Formula to Image"] = (typeof(GistHub.Pages.FormulaToImage), "tools/formula-to-image"),
            ["HTML to Image"] = (typeof(GistHub.Pages.HtmlToImage), "tools/html-to-image"),
            ["YouTube Downloader"] = (typeof(GistHub.Pages.YouTubeDownloader), "tools/youtube-downloader"),
            ["Local settings"] = (typeof(GistHub.Pages.Settings), "settings")
        };

    [Parameter] public string? ActiveTool { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public bool FocusOnOpen { get; set; } = true;
    [Parameter] public EventCallback<(string Name, ElementReference Trigger)> OnOpenWorkbenchTool { get; set; }
    private DynamicComponent? ToolComponent;
    private ElementReference BackButton;
    private string? RenderedTool, FocusedTool;
    private string? SaveError;

    protected override void OnParametersSet()
    {
        if (RenderedTool == ActiveTool) return;
        CaptureDraft();
        SaveError = null;
        RenderedTool = ActiveTool;
        ToolComponent = null;
    }

    private void CaptureDraft()
    {
        if (ToolComponent?.Instance is IToolDraft tool)
            Drafts.Save(ToolComponent.Instance.GetType(), tool.CaptureDraft());
    }

    public async Task<bool> SaveDraftAsync()
    {
        try
        {
            if (ToolComponent?.Instance is IToolDraft tool) await tool.SaveDraftAsync();
            CaptureDraft();
            SaveError = null;
            return true;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            SaveError = "Could not save this tool's draft. Keep a copy and try again before leaving.";
            await InvokeAsync(StateHasChanged);
            return false;
        }
    }

    private async Task BeforeNavigationAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (!await SaveDraftAsync()) context.PreventNavigation();
    }

    public void Dispose() => CaptureDraft();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusedTool == ActiveTool) return;
        FocusedTool = ActiveTool;
        if (ActiveTool is not null)
        {
            if (FocusOnOpen) await BackButton.FocusAsync();
        }
    }

}
