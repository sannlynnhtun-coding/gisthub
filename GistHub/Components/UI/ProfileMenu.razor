@implements IDisposable
@inject AppState AppState
@inject NavigationManager Navigation
@inject IStorageService Storage

@if (AppState.CurrentProfile is { } profile)
{
    <button @ref="Avatar" type="button" class="profile-avatar" popovertarget="profile-dropdown" aria-label="Open profile menu" aria-haspopup="dialog" title="Profile">
        <img src="@($"https://github.com/{Uri.EscapeDataString(profile.GithubUsername)}.png")" alt="" onerror="this.onerror=null;this.src='logo.svg'" />
        <span class="profile-chevron" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m5 9 7 7 7-7"/></svg></span>
    </button>
    <div id="profile-dropdown" class="profile-dropdown" popover="auto" role="dialog" aria-label="Your profile">
        <p class="profile-section-label">Currently in</p>
        <div class="profile-current-account">
            <img src="@($"https://github.com/{Uri.EscapeDataString(profile.GithubUsername)}.png")" alt="" onerror="this.onerror=null;this.src='logo.svg'" />
            <div class="profile-dropdown-identity">
                <strong>@profile.Name</strong>
                <p>GitHub account</p>
                <span>@@@profile.GithubUsername</span>
            </div>
        </div>
        <p class="profile-section-label profile-accounts">Your accounts</p>
        <button type="button" class="profile-signout" aria-expanded="@ShowAccounts" aria-controls="profile-account-list" @onclick="ToggleAccountsAsync">Switch accounts</button>
        <div id="profile-account-list" hidden="@(!ShowAccounts)" class="space-y-2 max-h-80 overflow-y-auto">
            @if (AccountsError is not null) { <p role="alert">@AccountsError</p> }
            @foreach (var account in SavedProfiles)
            {
                var current = account.Id == profile.Id;
                <button type="button" class="profile-current-account w-full text-left rounded-md p-2 hover:bg-accent"
                        aria-current="@(current ? "true" : null)" aria-label="@($"Switch to {account.GithubUsername}")"
                        popovertarget="profile-dropdown" popovertargetaction="hide" @onclick="() => SelectProfile(account)">
                    <img src="@($"https://github.com/{Uri.EscapeDataString(account.GithubUsername)}.png")" alt="" onerror="this.onerror=null;this.src='logo.svg'" />
                    <span class="profile-dropdown-identity min-w-0"><strong>@account.Name</strong><span>@@@account.GithubUsername</span>@if (current) { <span>Current account</span> }</span>
                </button>
            }
            <button type="button" class="profile-signout" popovertarget="profile-dropdown" popovertargetaction="hide" @onclick='() => Navigation.NavigateTo("/login")'>Add another account</button>
        </div>
        <button type="button" class="profile-signout" popovertarget="profile-dropdown" popovertargetaction="hide" @onclick="ShowLogoutConfirm">Log out</button>
    </div>
}
else
{
    <NavLink href="login" class="profile-avatar" aria-label="Sign in" title="Sign in">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
    </NavLink>
}

@if (IsLogoutConfirmOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 md:p-6">
        <button class="absolute inset-0 bg-black/40 backdrop-blur-sm cursor-default" aria-label="Cancel sign out" @onclick="CloseLogoutConfirm"></button>
        <div class="relative w-full max-w-md bg-card border border-border rounded-xl p-5 space-y-5" role="dialog" aria-modal="true" aria-labelledby="logout-confirm-title">
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-lg bg-destructive/5 text-destructive flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-out"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                </div>
                <div class="space-y-1">
                    <h2 id="logout-confirm-title" class="text-xl font-semibold tracking-tight">Sign out?</h2>
                    <p class="text-sm text-muted-foreground">Are you sure you want to sign out of your account?</p>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2">
                <button @onclick="CloseLogoutConfirm" class="btn btn-outline btn-md">Cancel</button>
                <button @onclick="ConfirmLogout" class="btn btn-destructive btn-md">Sign out</button>
            </div>
        </div>
    </div>
}


@code {
    private bool IsLogoutConfirmOpen;
    private ElementReference Avatar;
    private bool ShowAccounts;
    private List<GistProfile> SavedProfiles = new();
    private string? AccountsError;
    protected override void OnInitialized() => AppState.OnChange += StateHasChanged;
    private async Task ToggleAccountsAsync()
    {
        ShowAccounts = !ShowAccounts;
        if (!ShowAccounts) return;
        AccountsError = null;
        SavedProfiles.Clear();
        try { SavedProfiles = await Storage.GetProfilesAsync(); }
        catch (Exception) { AccountsError = "Could not load saved accounts. Close and reopen Switch accounts to retry."; }
    }
    private void SelectProfile(GistProfile profile)
    {
        ShowAccounts = false;
        AppState.SetProfile(profile);
        Navigation.NavigateTo("/");
    }
    private void ShowLogoutConfirm() => IsLogoutConfirmOpen = true;
    private async Task CloseLogoutConfirm()
    {
        IsLogoutConfirmOpen = false;
        await Avatar.FocusAsync();
    }
    private void ConfirmLogout()
    {
        IsLogoutConfirmOpen = false;
        AppState.SetProfile(null);
        Navigation.NavigateTo("/login");
    }
    public void Dispose() => AppState.OnChange -= StateHasChanged;
}
