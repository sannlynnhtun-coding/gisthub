@implements IAsyncDisposable
@inject IJSRuntime JS

@if (ActiveTool is not null)
{
    <PageTitle>@ActiveTool · GistHub</PageTitle>
}
@foreach (var name in OpenedTools)
{
    var active = name == ActiveTool;
    <div @key="name" class="tool-page-backdrop" hidden="@(!active)" @onclick="() => OnClose.InvokeAsync()">
        <section @ref="Dialogs[name]" class="tool-page-overlay" role="dialog" aria-modal="true"
                 aria-labelledby="@($"tool-page-title-{Pages[name].Component.Name}")" tabindex="-1"
                 data-tool-name="@name" @onclick:stopPropagation="true" @onkeydown="HandleKeyDown">
            <header class="tool-page-header">
                <h2 id="@($"tool-page-title-{Pages[name].Component.Name}")">@name</h2>
                <button @ref="CloseButtons[name]" type="button" @onclick="() => OnClose.InvokeAsync()" aria-label="@($"Close {name}")" title="Close (Esc)">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M6 18 18 6"/></svg>
                </button>
            </header>
            <div class="tool-page-content" inert="@(!active ? "" : null)">
                <CascadingValue Name="IsWorkbenchPopup" Value="true">
                    <CascadingValue Name="OpenWorkbenchTool" Value="OnOpenWorkbenchTool">
                        <DynamicComponent Type="Pages[name].Component" />
                    </CascadingValue>
                </CascadingValue>
            </div>
        </section>
    </div>
}

@code {
    public static readonly IReadOnlyDictionary<string, (Type Component, string Route)> Pages =
        new Dictionary<string, (Type, string)>
        {
            ["AI Tools & Skills"] = (typeof(GistHub.Pages.AgentSkills), "agent-skills"),
            ["Tools Guide"] = (typeof(GistHub.Pages.Tools), "tools"),
            ["Markdown Live Preview"] = (typeof(GistHub.Pages.MarkdownLivePreview), "tools/markdown-live-preview"),
            ["Markdown to DOCX"] = (typeof(GistHub.Pages.MarkdownToDocx), "tools/markdown-to-docx"),
            ["Markdown to Text"] = (typeof(GistHub.Pages.MarkdownToText), "tools/markdown-to-text"),
            ["Markdown to Cards"] = (typeof(GistHub.Pages.MarkdownToCards), "tools/markdown-to-cards"),
            ["draw.io Diagram Editor"] = (typeof(GistHub.Pages.DiagramEditor), "tools/diagram-editor"),
            ["Mermaid to Image"] = (typeof(GistHub.Pages.MermaidToImage), "tools/mermaid-to-image"),
            ["Formula to Image"] = (typeof(GistHub.Pages.FormulaToImage), "tools/formula-to-image"),
            ["HTML to Image"] = (typeof(GistHub.Pages.HtmlToImage), "tools/html-to-image"),
            ["YouTube Downloader"] = (typeof(GistHub.Pages.YouTubeDownloader), "tools/youtube-downloader"),
            ["Local settings"] = (typeof(GistHub.Pages.Settings), "settings")
        };

    [Parameter] public string? ActiveTool { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool FocusOnOpen { get; set; } = true;
    [Parameter] public EventCallback<(string Name, ElementReference Trigger)> OnOpenWorkbenchTool { get; set; }
    // Keep mounted tool instances so closing and reopening never discards their in-memory drafts.
    private readonly HashSet<string> OpenedTools = new();
    private readonly Dictionary<string, ElementReference> Dialogs = new(), CloseButtons = new();
    private IJSObjectReference? Module;
    private string? FocusedTool;

    protected override void OnParametersSet()
    {
        if (ActiveTool is not null && Pages.ContainsKey(ActiveTool)) OpenedTools.Add(ActiveTool);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusedTool == ActiveTool) return;
        Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/appShell.js");
        if (FocusedTool is not null) await Module.InvokeVoidAsync("deactivateFocusTrap", Dialogs[FocusedTool]);
        FocusedTool = ActiveTool;
        if (ActiveTool is not null)
        {
            await Module.InvokeVoidAsync("activateFocusTrap", Dialogs[ActiveTool]);
            if (FocusOnOpen) await CloseButtons[ActiveTool].FocusAsync();
        }
    }

    private Task HandleKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (Module is null) return;
        try
        {
            if (FocusedTool is not null) await Module.InvokeVoidAsync("deactivateFocusTrap", Dialogs[FocusedTool]);
            await Module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
