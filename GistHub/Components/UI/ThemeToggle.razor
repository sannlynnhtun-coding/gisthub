@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="neo-theme-picker" @ref="Picker" data-saved-theme="@Theme" data-saved-style="@Style" data-saved-font="@Font">
    <button class="neo-theme-trigger" type="button" popovertarget="@PanelId" aria-label="@($"{SelectedName} page theme")" aria-haspopup="dialog" title="Preview and choose a page theme">
        <span class="neo-theme-trigger__swatch" aria-hidden="true"></span>
        <span class="neo-theme-trigger__name">@SelectedName</span>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6" /></svg>
    </button>
    <div id="@PanelId" popover="auto" class="neo-theme-panel" role="dialog" aria-label="Choose a theme">
        <header class="neo-theme-panel__header">
            <div><span class="neo-theme-panel__eyebrow">Make it yours</span><h2>Choose your appearance</h2></div>
            <span class="neo-theme-panel__badge">LIVE</span>
        </header>
        <div class="flex flex-wrap items-center gap-2 p-3" role="group" aria-label="Copy and paste appearance">
            <button type="button" class="btn btn-sm" @onclick="CopyAppearance">Copy style</button>
            <button type="button" class="btn btn-sm" @onclick="OpenAppearancePaste">Paste style</button>
        </div>
        @if (ShowAppearanceJson)
        {
            <div class="p-3 space-y-2">
                <label for="@(PanelId)-json">Appearance JSON</label>
                <textarea @ref="JsonInput" id="@(PanelId)-json" @bind="AppearanceJson" rows="5" class="w-full border rounded-lg p-2" spellcheck="false"></textarea>
                <button type="button" class="btn btn-sm" @onclick="ImportAppearance">Apply style</button>
                <button type="button" class="btn btn-sm" @onclick="() => ShowAppearanceJson = false">Cancel</button>
            </div>
        }
        <AutoDismissMessage @bind-Message="AppearanceFeedback">
            <p role="status" aria-live="polite" class="px-3 text-sm">@AppearanceFeedback</p>
        </AutoDismissMessage>
        <div class="neo-appearance-tabs" role="tablist" aria-label="Appearance categories">
            <button type="button" id="@(PanelId)-themes-tab" role="tab" aria-selected="true" aria-controls="@(ListId)-panel" data-appearance-tab="themes">Themes</button>
            <button type="button" id="@(PanelId)-styles-tab" role="tab" aria-selected="false" aria-controls="@ListId" tabindex="-1" data-appearance-tab="styles">Styles</button>
            <button type="button" id="@(PanelId)-presets-tab" role="tab" aria-selected="false" aria-controls="@ListId" tabindex="-1" data-appearance-tab="presets">Presets</button>
            <button type="button" id="@(PanelId)-fonts-tab" role="tab" aria-selected="false" aria-controls="@(ListId)-panel" tabindex="-1" data-appearance-tab="fonts">Fonts</button>
        </div>
        <div class="neo-theme-panel__search">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" aria-label="Search themes" placeholder="Search themes…" autocomplete="off" aria-controls="@ListId" aria-describedby="@HintId" />
        </div>
        <div class="neo-appearance-summary"><span class="neo-appearance-count" role="status" aria-live="polite"></span><span>Preview live</span></div>
        <div class="neo-appearance-favorites">
            <button type="button" class="neo-theme-restore" data-appearance-favorite aria-pressed="false">Favorite current theme</button>
            <label><input type="checkbox" data-appearance-favorites-only /> Favorites only</label>
        </div>
        <p class="neo-appearance-summary" data-appearance-error role="status" aria-live="polite" hidden></p>
        <div id="@(ListId)-panel" role="tabpanel" aria-labelledby="@(PanelId)-themes-tab" class="neo-appearance-results">
        <div id="@ListId" class="neo-theme-options custom-scrollbar" role="listbox" aria-label="Available themes">
            <div role="group" aria-label="Color themes" data-appearance-group="themes">
                @foreach (var palette in Palettes.OrderBy(palette => palette.Name, StringComparer.OrdinalIgnoreCase))
                {
                    <button @key="palette.Id" type="button" role="option" tabindex="-1" aria-selected="@(Theme == palette.Id ? "true" : "false")"
                            class="neo-theme-option" data-theme-option="@palette.Id" data-appearance-kind="themes" data-search-text="@(palette.Name + " " + palette.Source)" @onclick="() => SelectTheme(palette.Id)">
                        <span class="neo-theme-option__colors" aria-hidden="true"><i style="background:@palette.Chrome"></i><i style="background:@palette.Primary"></i><i style="background:@palette.Secondary"></i></span>
                        <span class="neo-theme-option__name">@palette.Name<span class="neo-theme-option__source">@palette.Source</span></span>
                        <span class="neo-theme-option__check" aria-hidden="true">✓</span>
                    </button>
                }
            </div>
                <div role="group" aria-label="Interface styles" data-appearance-group="styles" hidden>
                    @foreach (var style in Styles.OrderBy(style => style.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <button @key="style.Id" type="button" role="option" tabindex="-1" aria-selected="@(Style == style.Id ? "true" : "false")" class="neo-theme-option"
                                data-style-option="@style.Id" data-appearance-kind="styles" data-search-text="@(style.Name + " " + style.Description)" @onclick="() => SelectStyle(style.Id)">
                            <span class="neo-style-option__icon" aria-hidden="true">Aa</span>
                            <span class="neo-theme-option__name">@style.Name<span class="neo-theme-option__source">@style.Description</span></span>
                            <span class="neo-theme-option__check" aria-hidden="true">✓</span>
                        </button>
                    }
                </div>
            <div role="group" aria-label="Style and theme combinations" data-appearance-group="presets" hidden>
                @foreach (var preset in Presets.OrderBy(preset => preset.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var palette = Palettes.FirstOrDefault(p => p.Id == preset.Theme);
                    <button @key="preset.Id" type="button" role="option" tabindex="-1" aria-selected="@(SelectedPreset == preset.Id ? "true" : "false")" class="neo-theme-option"
                            data-preset-option="@preset.Id" data-style-option="@preset.Style" data-theme-option="@preset.Theme" data-appearance-kind="presets" data-search-text="@preset.Name" @onclick="() => SelectPreset(preset.Id)">
                        <span class="neo-theme-option__colors" aria-hidden="true"><i style="background:@palette?.Chrome"></i><i style="background:@palette?.Primary"></i><i style="background:@palette?.Secondary"></i></span>
                        <span class="neo-theme-option__name">@preset.Name<span class="neo-theme-option__source">Style + color theme</span></span>
                        <span class="neo-theme-option__check" aria-hidden="true">✓</span>
                    </button>
                }
            </div>
                <div role="group" aria-label="Fonts" data-appearance-group="fonts" hidden>
                    @foreach (var font in Fonts.OrderBy(font => font.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <button @key="font.Id" type="button" role="option" tabindex="-1" aria-selected="@(Font == font.Id ? "true" : "false")" class="neo-theme-option"
                                data-font-option="@font.Id" data-appearance-kind="fonts" data-search-text="@(font.Name + " " + font.Group)" @onclick="() => SelectFont(font.Id)">
                            <span class="neo-style-option__icon" aria-hidden="true">Aa</span>
                            <span class="neo-theme-option__name">@font.Name<span class="neo-theme-option__source">@font.Group · @(font.Group == "Developer" ? "Website text and code" : "Website text; code keeps monospace")</span></span>
                            <span class="neo-theme-option__check" aria-hidden="true">✓</span>
                        </button>
                    }
                </div>
        </div>
        <p class="neo-theme-panel__empty" hidden>No matches. Try another name.</p>
        </div>
        <footer class="neo-theme-panel__footer">
            <div class="neo-appearance-reset"><button type="button" class="neo-theme-restore" @onclick="RestoreStyle">Reset style</button><button type="button" class="neo-theme-restore" @onclick="RestoreDefault">Restore default</button></div>
            <div id="@HintId">Hover or use ↑ ↓ to preview. Click or Enter to save. Select an appearance, then favorite it above.<span>Esc to cancel · <a href="settings">Local settings backup</a> · <a href="https://vscodethemes.com/" target="_blank" rel="noopener noreferrer">VS Code Themes</a></span></div>
        </footer>
    </div>
</div>

@code {
    private ElementReference Picker;
    private IJSObjectReference? Sharing;
    private bool ShowAppearanceJson;
    private bool FocusJson;
    private ElementReference JsonInput;
    private string AppearanceJson = "";
    private string AppearanceFeedback = "";
    private async Task<IJSObjectReference> GetSharing()
        => Sharing ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/appearanceSharing.js");
    private async Task CopyAppearance()
    {
        try
        {
            AppearanceJson = await (await GetSharing()).InvokeAsync<string>("exportAppearance", Picker);
            var copied = await JS.InvokeAsync<bool>("copyToClipboard", AppearanceJson);
            ShowAppearanceJson = !copied;
            FocusJson = !copied;
            AppearanceFeedback = copied ? "Appearance copied." : "Could not copy. Select the JSON and copy it manually.";
        }
        catch (JSException) { AppearanceFeedback = "Could not copy appearance. Check clipboard and browser storage access."; }
    }
    private void OpenAppearancePaste()
    {
        AppearanceJson = "";
        ShowAppearanceJson = true;
        FocusJson = true;
        AppearanceFeedback = "Paste appearance JSON, then choose Apply style.";
    }
    private async Task ImportAppearance()
    {
        try
        {
            var result = await (await GetSharing()).InvokeAsync<AppearanceSelection>("importAppearance", Picker, AppearanceJson);
            Theme = result.Theme; Style = result.Style; Font = result.Font;
            ShowAppearanceJson = false;
            AppearanceFeedback = "Appearance applied.";
        }
        catch (JSException ex) { AppearanceFeedback = $"Could not apply appearance: {ex.Message}"; }
    }
    private sealed record AppearanceSelection(string Theme, string Style, string Font);

    private string Font = "default";
    private List<FontOption> Fonts = [];
    private sealed record FontOption(string Id, string Name, string Family, string Group);

    private async Task SelectFont(string font)
    {
        Font = font;
        await JS.InvokeVoidAsync("commitGistHubFontPicker", Picker, font);
    }
    private string ListId => $"{PanelId}-options";
    private List<StylePreset> Presets = [];
    private sealed record StylePreset(string Id, string Name, string Style, string Theme);
    private string SelectedPreset => Presets.FirstOrDefault(p => p.Style == Style && p.Theme == Theme)?.Id ?? "";

    private async Task SelectPreset(string id)
    {
        var preset = await JS.InvokeAsync<StylePreset?>("applyGistHubStylePreset", Picker, id);
        if (preset is null) return;
        Style = preset.Style;
        Theme = preset.Theme;
    }

    private string Style = "default";
    private List<StyleOption> Styles = [];
    private sealed record StyleOption(string Id, string Name, string Description, string Group);

    private async Task SelectStyle(string style)
    {
        Style = style;
        await JS.InvokeVoidAsync("commitGistHubAppearancePicker", Picker, style, Theme);
    }

    private Task RestoreStyle() => SelectStyle("default");
    private readonly string PanelId = $"theme-picker-{Guid.NewGuid():N}";
    private string HintId => $"{PanelId}-hint";
    private bool IsInitialized;
    private string Theme = "";
    private List<ThemeOption> Palettes = [];
    private string SelectedName => Palettes.FirstOrDefault(p => p.Id == Theme)?.Name ?? "Themes";
    private sealed record ThemeOption(string Id, string Name, string Chrome, string Primary, string Secondary, string Source);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusJson && ShowAppearanceJson)
        {
            FocusJson = false;
            await JsonInput.FocusAsync();
        }
        if (firstRender)
        {
            Fonts.AddRange(await JS.InvokeAsync<FontOption[]>("getGistHubFonts"));
            Font = await JS.InvokeAsync<string>("getGistHubFont");
            Presets.AddRange(await JS.InvokeAsync<StylePreset[]>("getGistHubStylePresets"));
            Styles.AddRange(await JS.InvokeAsync<StyleOption[]>("getGistHubStyles"));
            Style = await JS.InvokeAsync<string>("getGistHubStyle");
            Palettes.AddRange(await JS.InvokeAsync<ThemeOption[]>("getGistHubThemes"));
            Theme = await JS.InvokeAsync<string>("getGistHubTheme");
            StateHasChanged();
        }
        else if (!IsInitialized)
        {
            await JS.InvokeVoidAsync("initializeGistHubThemePicker", Picker);
            IsInitialized = true;
        }
    }

    private async Task SelectTheme(string theme)
    {
        Theme = theme;
        await JS.InvokeVoidAsync("commitGistHubThemePicker", Picker, theme);
    }

    private async Task RestoreDefault()
    {
        await SelectFont("default");
        Theme = await JS.InvokeAsync<string>("getGistHubDefaultTheme");
        await SelectStyle("default");
    }

    public async ValueTask DisposeAsync()
    {
        if (Sharing is not null)
        {
            try { await Sharing.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        if (IsInitialized)
        {
            try { await JS.InvokeVoidAsync("closeGistHubThemePicker", Picker); }
            catch (JSDisconnectedException) { }
        }
    }
}
