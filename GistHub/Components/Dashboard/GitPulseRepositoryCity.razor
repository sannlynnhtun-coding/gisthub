@using GistHub.Models
@{
    var top = Rows.Where(repo => repo.SizeKb >= 0).OrderByDescending(repo => repo.SizeKb).Take(6).ToArray();
}
<section id="repo-city-card" class="bento-card p-4 sm:p-6" aria-labelledby="repo-city-title">
    <header class="flex items-start justify-between gap-2 mb-3">
        <div>
            <h2 id="repo-city-title">Top 6 repository footprint (3D)</h2>
            <p class="text-xs">GitHub repository size (KB) and stars</p>
        </div>
        <span class="px-2.5 py-1 rounded-full text-[11px] font-mono city-size border shrink-0">@((Rows.Sum(repo => (double)(repo.SizeKb ?? 0)) / 1024).ToString("F1")) MB · GitHub</span>
    </header>
    <div class="city-toolbar">
        <strong>GitHub repository footprint</strong>
        <span>@top.Length PROJECTS</span>
        @if (top.Length > 0) { <span>SELECT A BUILDING TO INSPECT</span> }
    </div>
    <div id="repo-city-scene">
        <div class="city-map">
        <svg viewBox="0 0 1080 560" role="group" aria-label="Isometric city of the six largest GitHub repositories">
            <defs>
                <pattern id="city-grid" width="56" height="28" patternUnits="userSpaceOnUse"><path d="M0 0 56 28M56 0 0 28" stroke="var(--city-grid)" stroke-width=".7" fill="none" /></pattern>
                <radialGradient id="city-light"><stop stop-color="var(--city-halo)" /><stop offset="1" stop-color="var(--city-ground)" /></radialGradient>
            </defs>
            <rect width="1080" height="560" fill="url(#city-light)" />
            <rect width="1080" height="560" fill="url(#city-grid)" />
            <path d="M0 590 1080 50M0 350 700 0M250 620 1080 205" stroke="var(--city-grid)" stroke-opacity=".4" fill="none" />
            @for (var index = 0; index < top.Length; index++)
            {
                var repo = top[index];
                var color = Colors[index];
                var (x, y) = Places[index];
                var height = 26 + (int)Math.Round(42d * repo.SizeKb!.Value / Math.Max(1, top[0].SizeKb!.Value), MidpointRounding.AwayFromZero);
                var shortName = repo.Name.Length > 23 ? repo.Name[..21] + "…" : repo.Name;
                <g @key="repo.Id" class="@($"city-building rack-{RackPalettes[index]}")" transform="@($"translate({x} {y}) scale(.82)")" style="@($"--city-color:{color}")">
                    <title>@repo.Name · @repo.SizeKb KB</title>
                    <path d="M-100 4 0-47 112 10 12 64Z" fill="var(--city-deck)" stroke="@color" stroke-opacity=".45" />
                    <path d="M-99-7 0-58 112 0M-91 20 12 74 111 22" fill="none" stroke="@color" stroke-width="3" class="city-roof" />
                    <path d="M-140 14-86 41-30 16 44 52 116 15" fill="none" stroke="@color" stroke-width="2" class="city-packets" />
                    @for (var rack = 0; rack < 3; rack++)
                    {
                        <g transform="@($"translate({rack * 25 - 30},{rack * 11 - 14})")">
                            <path d="@($"M0 {-height}l16 8v{height}l-16-8Z")" fill="var(--rack-front)" />
                            <path d="@($"M16 {8 - height}l13-8v{height}l-13 8Z")" fill="var(--rack-side)" />
                            <path d="@($"M0 {-height}l13-8 16 8-13 8Z")" fill="var(--rack-top)" />
                            @for (var light = 0; light < 5; light++)
                            {
                                <path d="@($"M3 {-height + 12 + light * 8}l10 5")" stroke="var(--rack-top)" stroke-width="2" class="city-server-light" style="@FormattableString.Invariant($"animation-delay:{light * .2}s")" />
                            }
                        </g>
                    }
                    <ellipse cx="69" cy="23" rx="9" ry="5" fill="var(--city-ground)" stroke="@color" />
                    <path d="M60 5v18m18-18v18" stroke="@color" />
                    <ellipse cx="69" cy="5" rx="9" ry="5" fill="var(--city-rack)" stroke="@color" />
                    <g transform="translate(-85 73)">
                        <rect width="190" height="45" rx="4" fill="var(--city-panel)" fill-opacity=".92" stroke="@color" stroke-opacity=".6" />
                        <text x="95" y="17" text-anchor="middle" fill="var(--city-text)" font-size="11" font-weight="700">@shortName</text>
                        <text x="95" y="33" text-anchor="middle" fill="var(--city-muted)" font-size="9">@((repo.SizeKb.Value / 1024d).ToString("F1")) MB · @repo.Stars ★ · GitHub</text>
                    </g>
                </g>
            }
            @if (top.Length == 0)
            {
                <g><text x="540" y="310" text-anchor="middle" fill="var(--city-muted)">Repository sizes are unavailable for the current result.</text></g>
            }
        </svg>
        <div class="city-hit-map">
            @for (var index = 0; index < top.Length; index++)
            {
                var repo = top[index];
                var (x, y) = Places[index];
                <button @key="repo.Id" id="@($"city-{repo.Id}")" type="button" class="city-building-hit"
                        style="@($"--city-x:{x};--city-y:{y};--city-color:{Colors[index]}")"
                        aria-label="@($"Inspect {repo.Name}")" title="@($"{repo.Name} · {repo.SizeKb} KB")"
                        @onclick="() => RepositorySelected.InvokeAsync(repo)"><span class="city-building-name">@repo.Name</span></button>
            }
        </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public IReadOnlyList<GithubRepository> Rows { get; set; } = [];
    [Parameter] public EventCallback<GithubRepository> RepositorySelected { get; set; }

    private static readonly (int X, int Y)[] Places = [(420,120), (240,225), (650,220), (450,325), (690,420), (855,325)];
    private static readonly string[] Colors = ["var(--city-accent)", "var(--city-cyan)", "var(--city-gold)", "var(--city-green)", "var(--city-cap)", "var(--city-pink)"];
    private static readonly string[] RackPalettes = ["cyan", "amber", "violet", "orange", "indigo", "pink"];
}
