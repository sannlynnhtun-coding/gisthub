@using GistHub.Models
@using GistHub.Services
@using static GistHub.Services.GithubDashboardSummary
@inject IGithubService Github

<section id="@(Cadence ? "view-cadence" : "view-benchmarks")" data-gitpulse-view="@(Cadence ? "cadence" : "benchmarks")" class="gitpulse-view tab-panel space-y-5">
    @if (!Cadence)
    {
        <GitPulseRepositoryCity Rows="Rows" RepositorySelected="RepositorySelected" />
    }
    <div class="bento-card p-6">
        <h2>@(Cadence ? "Releases & milestones" : "GitHub Actions runs")</h2>
        @if (Rows.Count == 0)
        {
            <p>No repositories loaded.</p>
        }
        else
        {
            <label class="analytics-field">Repository
                <select @bind="RepositoryId" @bind:after="LoadAsync">
                    @foreach (var repo in Rows)
                    {
                        <option value="@repo.Id">@repo.Name</option>
                    }
                </select>
            </label>
            @if (Loading)
            {
                <p role="status">Loading GitHub activity…</p>
            }
            else
            {
                @foreach (var feed in Feeds)
                {
                    <h3>@feed.Heading</h3>
                    @if (feed.Items is null)
                    {
                        <p>GitHub data unavailable. Check repository access and token permissions.</p>
                    }
                    else if (feed.Items.Count == 0)
                    {
                        <p>No entries returned by GitHub.</p>
                    }
                    else
                    {
                        <ul class="analytics-list">
                            @foreach (var entry in feed.Items)
                            {
                                <li>
                                    @if (SafeGithubUrl(entry.Url) is { } url)
                                    {
                                        <a href="@url" target="_blank" rel="noopener noreferrer">@entry.Name</a>
                                    }
                                    else { <span>@entry.Name</span> }
                                    <span> · @entry.Status</span>
                                    @if (entry.Date is { } date) { <small> · @date.UtcDateTime.ToString("yyyy-MM-dd") UTC</small> }
                                </li>
                            }
                        </ul>
                    }
                }
            }
        }
    </div>
</section>

@code {
    [Parameter] public IReadOnlyList<GithubRepository> Rows { get; set; } = [];
    [Parameter] public EventCallback<GithubRepository> RepositorySelected { get; set; }
    [Parameter] public string Token { get; set; } = "";
    [Parameter] public bool Cadence { get; set; }

    private long RepositoryId;
    private bool Loading;
    private int Request;
    private IReadOnlyList<(string Heading, IReadOnlyList<GithubRepositoryActivity>? Items)> Feeds = [];

    protected override async Task OnParametersSetAsync()
    {
        if (RepositoryId != 0 || Rows.Count == 0) return;
        RepositoryId = Rows[0].Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var request = ++Request;
        var repo = Rows.First(item => item.Id == RepositoryId);
        Loading = true;
        IReadOnlyList<(string Heading, IReadOnlyList<GithubRepositoryActivity>? Items)> feeds;
        if (Cadence)
        {
            var releases = Github.GetRepositoryActivityAsync(repo, "releases", Token);
            var milestones = Github.GetRepositoryActivityAsync(repo, "milestones", Token);
            feeds = [("Recent releases (up to 20)", await releases), ("Open milestones (up to 20, dates shown are due dates)", await milestones)];
        }
        else
        {
            feeds = [("Recent workflow runs (up to 20, creation dates in UTC)", await Github.GetRepositoryActivityAsync(repo, "actions/runs", Token))];
        }
        if (request != Request) return;
        Feeds = feeds;
        Loading = false;
    }
}
