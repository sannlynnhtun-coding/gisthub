@using GistHub.Models
@using GistHub.Services
@inject GistSearchService Search
@inject IJSRuntime JS

@* Adapted from Looseleaf's MIT notes-app and notebook components; see fonts/Looseleaf-SOURCES.txt. *@
<section class="looseleaf-notes" data-view="@(ShowPage ? "page" : "list")" aria-label="Looseleaf notebook">
    <aside class="looseleaf-shelf" aria-label="Notes shelf">
        <header>
            <h2 tabindex="-1" @ref="ShelfHeading">Notes</h2>
            <button type="button" class="btn btn-primary btn-sm" @onclick="NewPageAsync">＋ New page</button>
        </header>
        <label for="looseleaf-search">Search this notebook</label>
        <input id="looseleaf-search" type="search" placeholder="Title, filename, or content…" @bind="Query" @bind:event="oninput" />
        <div class="looseleaf-shelf-body">
            <nav aria-label="Notebooks">
                <button type="button" aria-pressed='@(Notebook == "" ? "true" : "false")' @onclick='() => Notebook = ""'>All pages <span>@Gists.Count</span></button>
                @foreach (var name in Notebooks)
                {
                    <button type="button" aria-pressed="@(Notebook == name ? "true" : "false")" @onclick="() => Notebook = name">@name <span>@Gists.Count(g => g.CollectionNames.Contains(name))</span></button>
                }
            </nav>
            <div class="looseleaf-page-list">
                <p role="status">@VisiblePages.Count page@(VisiblePages.Count == 1 ? "" : "s")</p>
                @if (VisiblePages.Count == 0)
                {
                    <h3>No page says that</h3>
                    <p>Try another word or start a new page.</p>
                }
                <ul aria-label="Notebook pages">
                    @foreach (var gist in VisiblePages)
                    {
                        <li @key="gist.Id">
                            <button type="button" class="looseleaf-index-card" aria-current="@(SelectedId == gist.Id ? "true" : null)" @onclick="() => OpenPageAsync(gist.Id)">
                                <strong>@Title(gist)</strong>
                                <span class="looseleaf-excerpt">@Excerpt(gist)</span>
                                <small>@gist.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy") @(gist.IsBookmarked ? "· Bookmarked" : "")</small>
                            </button>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <a class="looseleaf-credit" href="https://github.com/kevintngo/looseleaf" target="_blank" rel="noopener noreferrer">Looseleaf · Kevin Sans · MIT</a>
    </aside>

    <section class="looseleaf-page-pane" tabindex="-1" @ref="PagePane" aria-label="Notebook page">
        @if (Writing)
        {
            <GistHub.Pages.Editor @key="EditorKey" @ref="Editor" Embedded="true" GistId="@SelectedId" InitialFilename="@Filename" OnSaved="SavedAsync" OnCancel="BackAsync" />
        }
        else if (Selected is { } note)
        {
            <div class="looseleaf-page-toolbar">
                <button type="button" class="btn btn-outline btn-sm" @onclick="BackAsync">← Notes</button>
                <div role="group" aria-label="Page mode">
                    <button type="button" aria-pressed="true">Page</button>
                    <button type="button" aria-pressed="false" @onclick="WriteAsync">Write</button>
                </div>
                <button type="button" class="btn btn-outline btn-sm" @onclick="() => OnBookmark.InvokeAsync(note)">@(note.IsBookmarked ? "Remove bookmark" : "Bookmark")</button>
                <button type="button" class="btn btn-destructive btn-sm" @onclick="() => OnDelete.InvokeAsync(note)">Tear out</button>
            </div>
            @if (note.Files.Count > 1)
            {
                <label for="looseleaf-file">File</label>
                <select id="looseleaf-file" value="@Filename" @onchange="ChangeFile">
                    @foreach (var file in note.Files) { <option value="@file.Key">@file.Key</option> }
                </select>
            }
            <article class="looseleaf-paper" @ondblclick="WriteAsync">
                <h2>@Title(note)</h2>
                <p class="looseleaf-page-meta">@Filename · @(note.Public ? "Public" : "Secret")</p>
                @if (CurrentFile?.Content is null || CurrentFile.Truncated)
                {
                    <p role="status">This file is not completely cached. Sync gists before editing.</p>
                }
                else if (IsMarkdown)
                {
                    <div class="neo-markdown-preview" @ref="Markdown"></div>
                }
                else
                {
                    <pre><code>@CurrentFile.Content</code></pre>
                }
                <footer>@WordCount words · @(string.IsNullOrEmpty(Notebook) ? "All pages" : Notebook)</footer>
            </article>
        }
        else
        {
            <div class="looseleaf-paper">
                <h2>Pick a page</h2>
                <p>Open a note from the shelf, or start a new page.</p>
                <button type="button" class="btn btn-primary btn-md" @onclick="NewPageAsync">New page</button>
            </div>
        }
    </section>
</section>

@code {
    [Parameter] public IReadOnlyList<LocalGist> Gists { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback<LocalGist> OnDelete { get; set; }
    [Parameter] public EventCallback<LocalGist> OnBookmark { get; set; }
    private string Query = "", Notebook = "", Filename = "";
    private string? SelectedId;
    private bool Writing, ShowPage, RenderMarkdown, FocusPage, FocusShelf;
    private string EditorKey = "";
    private GistHub.Pages.Editor? Editor;
    private ElementReference ShelfHeading, PagePane, Markdown;
    private LocalGist? Selected => Gists.FirstOrDefault(g => g.Id == SelectedId);
    private GistFile? CurrentFile => Selected?.Files.GetValueOrDefault(Filename);
    private bool IsMarkdown => Filename.EndsWith(".md", StringComparison.OrdinalIgnoreCase);
    private int WordCount => (CurrentFile?.Content ?? "").Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
    private IEnumerable<string> Notebooks => Gists.SelectMany(g => g.CollectionNames).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);
    private List<LocalGist> VisiblePages
    {
        get
        {
            var pages = Gists.Where(g => Notebook == "" || g.CollectionNames.Contains(Notebook)).ToList();
            if (string.IsNullOrWhiteSpace(Query)) return pages;
            var ids = Search.Search(pages, Query, false, int.MaxValue).Results.Select(r => r.GistId).ToHashSet();
            return pages.Where(g => ids.Contains(g.Id)).ToList();
        }
    }
    private static string Title(LocalGist note) => string.IsNullOrWhiteSpace(note.Description) ? "Untitled" : note.Description;
    private static string Excerpt(LocalGist note)
    {
        var content = note.Files.Values.FirstOrDefault()?.Content ?? "Nothing written yet.";
        return content[..Math.Min(content.Length, 140)];
    }
    protected override void OnParametersSet()
    {
        if (!Writing && Selected is null) SelectPage(Gists.FirstOrDefault()?.Id);
    }
    private void SelectPage(string? id)
    {
        SelectedId = id;
        Filename = Selected?.Files.Keys.FirstOrDefault() ?? "";
        RenderMarkdown = true;
    }
    private async Task<bool> LeaveAsync() => !Writing || Editor is null || await Editor.CanLeaveAsync();
    private async Task OpenPageAsync(string id)
    {
        if (!await LeaveAsync()) return;
        Writing = false; Editor = null; SelectPage(id); ShowPage = true; FocusPage = true;
    }
    private async Task NewPageAsync()
    {
        if (!await LeaveAsync()) return;
        SelectPage(null); StartWriting();
    }
    private void WriteAsync() { if (Selected is not null) StartWriting(); }
    private void StartWriting()
    {
        EditorKey = Guid.NewGuid().ToString(); Writing = true; ShowPage = true; FocusPage = true;
    }
    private async Task BackAsync()
    {
        if (!await LeaveAsync()) return;
        Writing = false; Editor = null; ShowPage = false; FocusShelf = true; RenderMarkdown = true;
    }
    private void ChangeFile(ChangeEventArgs args) { Filename = args.Value?.ToString() ?? ""; RenderMarkdown = true; }
    private async Task SavedAsync(LocalGist note)
    {
        Writing = false; Editor = null;
        await OnSaved.InvokeAsync();
        SelectPage(note.Id); ShowPage = true; FocusPage = true;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (RenderMarkdown && !Writing && IsMarkdown && CurrentFile?.Content is { } content && Markdown.Id is not null)
        {
            RenderMarkdown = false;
            await JS.InvokeVoidAsync("renderMarkdown", Markdown, content);
        }
        if (FocusPage) { FocusPage = false; await PagePane.FocusAsync(); }
        if (FocusShelf) { FocusShelf = false; await ShelfHeading.FocusAsync(); }
    }
}
