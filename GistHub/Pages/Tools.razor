@page "/tools"

@if (!IsToolWorkspace) { <PageTitle>Tools Guide · GistHub</PageTitle> }
<section class="compact-tool-page space-y-8" aria-labelledby="tools-guide-title">
    <div class="neo-page-heading space-y-3 pb-7 border-b">
        <div class="neo-kicker">Workbench / Guide</div>
        <div class="tool-heading-inline"><h2 id="tools-guide-title" class="text-3xl font-black tracking-tight">Find the right tool</h2> @if (!IsToolWorkspace) { <ToolHelp Name="Tools Guide" /> }</div>
        <p class="text-muted-foreground">Clean up data, prepare documents, or turn an idea into something you can share. Here’s what each tool does and when to use it.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" aria-label="Available tools">
        @foreach (var name in ToolsList)
        {
            var tool = ToolHelpContent.Entries[name];
            <article class="bg-card border border-border rounded-md p-6 flex flex-col gap-4">
                <div class="flex items-center gap-2"><h3 class="text-xl font-bold">@name</h3><ToolHelp Name="@name" /></div>
                <p>@tool.Purpose</p>
                <p class="text-sm text-muted-foreground"><strong>Try it when:</strong> @tool.Example</p>
                <button type="button" @ref="ToolTriggers[name]" @onclick="() => OpenWorkbenchTool.InvokeAsync((name, ToolTriggers[name]))" class="btn btn-outline btn-md mt-auto self-start" aria-label="@($"Open {name}")">Open tool →</button>
            </article>
        }
    </div>
</section>

@code {
    [CascadingParameter(Name = "IsToolWorkspace")] public bool IsToolWorkspace { get; set; }
    [CascadingParameter(Name = "OpenWorkbenchTool")]
    public EventCallback<(string Name, ElementReference Trigger)> OpenWorkbenchTool { get; set; }

    private readonly Dictionary<string, ElementReference> ToolTriggers = new();

    private static readonly string[] ToolsList =
    [
        "Cron Expression",
        "Password Generator",
        "AI Tools & Skills",
        "JSON Parser",
        "JSON to Table",
        "Base64 Encode / Decode",
        "Markdown Live Preview",
        "Markdown to Text",
        "Markdown + Code Converter",
        "HTML to Image",
        "Markdown to DOCX",
        "Markdown to Cards",
        "draw.io Diagram Editor",
        "Mermaid to Image",
        "Formula to Image",
        "YouTube Downloader",
    ];
}
