@page "/tools/visual-studio-shortcuts"

@if (!IsToolWorkspace) { <PageTitle>Visual Studio Shortcuts · GistHub</PageTitle> }
<section class="compact-tool-page space-y-6" aria-labelledby="vs-shortcuts-title">
    <div class="neo-page-heading space-y-3 pb-7 border-b">
        <div class="neo-kicker">Workbench / Reference</div>
        <div class="tool-heading-inline"><h2 id="vs-shortcuts-title" class="text-3xl font-black tracking-tight">Visual Studio Shortcuts</h2> @if (!IsToolWorkspace) { <ToolHelp Name="Visual Studio Shortcuts" /> }</div>
        <p class="text-muted-foreground">Keyboard shortcuts for Visual Studio on Windows. Bindings can vary by keyboard profile, version, and extensions.</p>
        <p class="text-sm text-muted-foreground">Key notation follows the reference sheet; some commands use successive key combinations. Configure bindings in Tools → Options → Environment → Keyboard.</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        @foreach (var category in Categories)
        {
            <section class="bg-card border border-border rounded-md p-4 md:p-6 min-w-0">
                <table class="w-full text-left table-fixed text-sm">
                    <caption class="text-left text-xl font-bold mb-4">@category.Title</caption>
                    <thead><tr class="border-b border-border"><th scope="col" class="py-2 pr-3">Action</th><th scope="col" class="py-2">Shortcut</th></tr></thead>
                    <tbody>
                        @foreach (var row in category.Rows)
                        {
                            <tr class="border-b border-border"><th scope="row" class="py-3 pr-3 font-normal break-words">@row.Action</th><td class="py-3 break-words"><kbd class="font-mono text-xs bg-muted border border-border rounded px-1">@row.Keys</kbd></td></tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    </div>
</section>

