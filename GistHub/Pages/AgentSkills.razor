@page "/agent-skills"
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>AI Agent Tools &amp; Skills · GistHub</PageTitle>
<section class="skills-page" aria-labelledby="skills-title">
    <header class="skills-heading">
        <div>
            <h2 id="skills-title">AI tools &amp; skills</h2>
            <p>Find the right skill, read it in English or မြန်မာ, and copy a method.</p>
        </div>
        <details class="skills-about">
            <summary>About this catalog</summary>
            <p>Includes the <a href="https://www.chaseai.io/blog/best-claude-code-plugins-skills-clis" target="_blank" rel="noopener noreferrer">Chase AI list</a> and all installed skills from personal, shared and plugin skill folders.</p>
            <p>“Installed locally” is a snapshot of this workspace’s skill files on 1 Nov 2026. It does not detect your device or CLI authentication.</p>
            <p>Methods are documented examples. Replace placeholders and follow the referenced guide for prerequisites and the working directory. Run terminal commands in a terminal and skill prompts in your agent’s chat.</p>
        </details>
    </header>
    <div class="skills-filters">
        <label for="skills-search">Search skills &amp; methods<input id="skills-search" type="search" placeholder="Try a skill name, task, or command…" @bind="Search" @bind:event="oninput" @bind:after="ResetPage" /></label>
        <label for="skills-category">Category<select id="skills-category" @bind="Category" @bind:after="ResetPage"><option value="">All categories</option>@foreach (var category in Skills.Select(s => s.Category).Distinct().Order()) { <option>@category</option> }</select></label>
        <label for="skills-agent">Agent / environment<select id="skills-agent" @bind="Agent" @bind:after="ResetPage"><option value="">All environments</option>@foreach (var agent in Skills.Select(s => s.Agent).Distinct().Order()) { <option>@agent</option> }</select></label>
        <label class="skills-checkbox"><input type="checkbox" @bind="InstalledOnly" @bind:after="ResetPage" /> Installed locally</label>
        <button type="button" class="btn btn-outline btn-sm" @onclick="Reset">Clear filters</button>
    </div>
    <div class="skills-status" role="status" aria-live="polite">@Status</div>
    @if (Loading)
    {
        <p role="status">Loading skills…</p>
    }
    else if (Error is not null)
    {
        <p role="alert">@Error</p><button type="button" class="btn btn-outline btn-sm" @onclick="LoadAsync">Retry</button>
    }
    else
    {
        var filtered = Skills.Where(s => s.Matches(Search, Category, Agent, InstalledOnly)).ToList();
        var totalPages = Math.Max(1, (filtered.Count + PageSize - 1) / PageSize);
        var rows = filtered.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
        <div class="skills-results-bar">
            <div class="skills-result-actions">
                <p class="skills-count" role="status">@filtered.Count of @Skills.Count skills</p>
                <button type="button" class="skills-expand" @onclick="() => MethodsExpanded = !MethodsExpanded">@(MethodsExpanded ? "Collapse all methods" : "Expand all methods")</button>
            </div>
            <nav class="skills-pagination" aria-label="Skill catalog pages">
                <button type="button" class="btn btn-outline btn-sm" disabled="@(CurrentPage <= 1)" @onclick="() => CurrentPage--">Previous</button>
                <span role="status">Page @CurrentPage of @totalPages</span>
                <button type="button" class="btn btn-outline btn-sm" disabled="@(CurrentPage >= totalPages)" @onclick="() => CurrentPage++">Next</button>
            </nav>
        </div>
        <div class="skills-sheet" role="region" aria-label="Skill catalog">
            <table role="table">
                <caption class="sr-only">AI tools and skills with categories, bilingual descriptions, installation and invocation examples.</caption>
                <thead><tr><th scope="col">Skill</th><th scope="col">Description · EN / MM</th></tr></thead>
                @foreach (var skill in rows)
                {
                    var methods = skill.CallMethods;
                    var matchingMethods = string.IsNullOrWhiteSpace(Search) || skill.Name.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase)
                        ? methods : methods.Where(m => m.Name.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase) || m.Call.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();
                    var shownMethods = matchingMethods.Length > 0 ? matchingMethods : methods;
                    <tbody class="skills-group" @key="skill.Name">
                        <tr class="skills-summary">
                            <th scope="row">
                                @if (skill.Source is not null)
                                {
                                    <a class="skills-name" href="@skill.Source" target="_blank" rel="noopener noreferrer">@skill.Name<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 3h7v7m0-7L10 14"/><path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5"/></svg></a>
                                }
                                else { <span class="skills-name">@skill.Name</span> }
                                <div class="skills-badges">
                                    <span class="skills-badge skills-badge--category" title="Category">@skill.Category</span>
                                    <span class="skills-badge skills-badge--type" title="Type">@skill.Type</span>
                                    <span class="skills-badge skills-badge--agent" title="Agent / Environment">@skill.Agent</span>
                                </div>
                                <div class="skills-origin">
                                    @if (skill.Installed) { <span class="skills-installed">Installed locally</span> }
                                    @if (skill.Article) { <span>Chase AI list</span> }
                                </div>
                            </th>
                            <td class="skills-description">
                                <p lang="en">@skill.DescriptionEn</p>
                                <p lang="my">@skill.DescriptionMm</p>
                            </td>
                        </tr>
                        <tr class="skills-detail-row">
                            <td colspan="2">
                                <details class="skills-methods" open="@MethodsExpanded">
                                    <summary aria-label="@($"{skill.Name}: setup and {methods.Length} methods")">
                                        Setup &amp; methods
                                        <span class="skills-method-count">@methods.Length @(methods.Length == 1 ? "method" : "methods")</span>
                                        @if (shownMethods.Length < methods.Length) { <span class="skills-matching">@shownMethods.Length matching · clear search to see all</span> }
                                    </summary>
                                    <div class="skills-usage">
                                        <section class="skills-setup" aria-label="@($"{skill.Name} installation")">
                                            <div class="skills-method-heading">
                                                <h3>Install / setup</h3>
                                                <button type="button" class="btn btn-outline btn-sm skills-copy" @onclick='() => CopyAsync(skill.Install, skill.Name + " setup")' aria-label="@($"Copy {skill.Name} setup")">Copy</button>
                                            </div>
                                            <pre>@skill.Install</pre>
                                        </section>
                                        <section class="skills-calls" aria-label="@($"{skill.Name} invocation methods")">
                                            <h3>How to call</h3>
                                            <ol class="skills-method-list" tabindex="0" aria-label="@($"{skill.Name} methods; scroll for more")">
                                                @foreach (var method in shownMethods)
                                                {
                                                    <li>
                                                        <div class="skills-method-heading">
                                                            <strong>@method.Name</strong>
                                                            <button type="button" class="btn btn-outline btn-sm skills-copy" @onclick='() => CopyAsync(method.Call, $"{skill.Name}: {method.Name}")' aria-label="@($"Copy {skill.Name}: {method.Name}")">Copy</button>
                                                        </div>
                                                        <pre>@method.Call</pre>
                                                        @if (method.Reference is not null) { <small>@method.Reference</small> }
                                                    </li>
                                                }
                                            </ol>
                                        </section>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    </tbody>
                }
                @if (rows.Count == 0)
                {
                    <tbody><tr><td colspan="2" class="skills-empty"><strong>No matching skills</strong><p>Try a shorter query or clear your filters to browse the catalog.</p><button type="button" class="btn btn-outline btn-sm" @onclick="Reset">Clear filters</button></td></tr></tbody>
                }
            </table>
        </div>
    }
</section>

@code {
    private List<AgentSkill> Skills = [];
    private string Search = "", Category = "", Agent = "", Status = "";
    private bool InstalledOnly, Loading = true;
    private bool MethodsExpanded = true;
    private const int PageSize = 50;
    private int CurrentPage = 1;
    private string? Error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try { Skills = await Http.GetFromJsonAsync<List<AgentSkill>>("data/agent-skills.json") ?? []; }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        { Error = "Could not load the skill catalog. Please retry."; }
        finally { Loading = false; }
    }

    private void ResetPage() => CurrentPage = 1;
    private void Reset() { Search = Category = Agent = Status = ""; InstalledOnly = false; ResetPage(); }

    private async Task CopyAsync(string text, string label)
    {
        try { Status = await JS.InvokeAsync<bool>("copyToClipboard", text) ? $"Copied {label}." : "Could not copy. Select the text and copy it manually."; }
        catch (JSException) { Status = "Clipboard unavailable. Select the text and copy it manually."; }
    }
}
