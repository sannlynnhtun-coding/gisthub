@page "/tools/password-generator"
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (!IsToolWorkspace) { <PageTitle>Password Generator · GistHub</PageTitle> }
<section class="compact-tool-page space-y-6 bg-background p-2 overflow-auto" aria-labelledby="password-generator-title">
    <div>
        <div class="neo-kicker mb-2">Workbench / Security</div>
        <h2 id="password-generator-title" class="text-3xl font-black tracking-tight">Password Generator</h2>
        <p class="text-muted-foreground mt-2">Create a random password, memorable passphrase, or PIN. Generated locally in your browser, never saved or sent to a server.</p>
    </div>
    <div class="bg-card border border-border rounded-md p-6 space-y-6">
        <div>
            <label for="password-result" class="block font-bold mb-2">Generated password</label>
            <input id="password-result" class="w-full bg-background border border-border rounded-md p-4 font-mono" type="text" readonly value="@Password" autocomplete="off" spellcheck="false" />
        </div>
        <div class="flex flex-wrap gap-4">
            <button id="password-generate" type="button" class="btn btn-primary btn-md" @onclick="GenerateAsync" disabled="@(Module is null)">Generate password</button>
            <button id="password-copy" type="button" class="btn btn-outline btn-md" @onclick="CopyAsync" disabled="@string.IsNullOrEmpty(Password)">Copy password</button>
        </div>
        <div class="flex flex-wrap items-center gap-4">
            <label for="password-type">Password type</label>
            <select id="password-type" class="bg-background border border-border rounded-md p-2" @bind="Type" @bind:after="GenerateAsync">
                <option value="random">Random</option>
                <option value="memorable">Memorable</option>
                <option value="pin">PIN</option>
            </select>
            @if (Type == "memorable")
            {
                <label for="password-words">Words: @WordCount</label>
                <input id="password-words" type="range" min="4" max="10" @bind="WordCount" @bind:after="GenerateAsync" />
                <label for="password-separator">Separate words with</label>
                <select id="password-separator" class="bg-background border border-border rounded-md p-2" @bind="Separator" @bind:after="GenerateAsync">
                    <option value="-">Hyphens (-)</option>
                    <option value=" ">Spaces</option>
                    <option value="_">Underscores (_)</option>
                    <option value=".">Periods (.)</option>
                </select>
            }
            else
            {
                <label for="password-length">Length: @Length</label>
                <input id="password-length" type="range" min="4" max="128" @bind="Length" @bind:after="GenerateAsync" />
            }
        </div>
        @if (Type == "memorable")
        {
            <fieldset class="flex flex-wrap gap-4">
                <legend class="font-bold mb-2">Word options</legend>
                <label><input id="password-capitalize" type="checkbox" @bind="CapitalizeWords" @bind:after="GenerateAsync" /> Capitalize each word</label>
                <label><input id="password-include-number" type="checkbox" @bind="IncludeNumber" @bind:after="GenerateAsync" /> Add a random digit (0–9) at the end</label>
            </fieldset>
        }
        @if (Type == "random")
        {
            <fieldset class="flex flex-wrap gap-4">
                <legend class="font-bold mb-2">Include characters</legend>
                <label><input type="checkbox" @bind="Uppercase" @bind:after="GenerateAsync" /> Uppercase (A–Z)</label>
                <label><input type="checkbox" @bind="Lowercase" @bind:after="GenerateAsync" /> Lowercase (a–z)</label>
                <label><input type="checkbox" @bind="Numbers" @bind:after="GenerateAsync" /> Numbers (0–9)</label>
                <label><input type="checkbox" @bind="Symbols" @bind:after="GenerateAsync" /> Symbols</label>
            </fieldset>
        }
        @if (Error is not null) { <p role="alert" class="text-destructive">@Error</p> }
        <p role="status" aria-live="polite">@Status</p>
    </div>
    <p class="text-sm text-muted-foreground">Use a different password for every account and keep it in your password manager. PINs have fewer possible combinations than passwords of the same length. Copying places your password on your device’s clipboard.</p>
    <p class="text-sm text-muted-foreground">Inspired by <a class="underline" href="https://1password.com/password-generator" target="_blank" rel="noopener noreferrer">1Password’s password generator</a>.</p>
    @if (Type == "memorable")
    {
        <p class="text-sm text-muted-foreground">Each word is selected independently from the 7,776-word <a class="underline" href="https://www.eff.org/dice" target="_blank" rel="noopener noreferrer">Electronic Frontier Foundation word list</a> (<a class="underline" href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>). Six words is the default; more words give more possible combinations. Some words contain a hyphen.</p>
    }
</section>

@code {
    [CascadingParameter(Name = "IsToolWorkspace")] public bool IsToolWorkspace { get; set; }
    private string Type = "random", Password = "", Status = "";
    private int Length = 20;
    private int WordCount = 6;
    private string Separator = "-";
    private bool Uppercase = true, Lowercase = true, Numbers = true, Symbols = true;
    private bool CapitalizeWords, IncludeNumber;
    private string? Error;
    private IJSObjectReference? Module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            Module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/passwordGenerator.js");
            await GenerateAsync();
        }
        catch (JSException) { Error = "Password generation is unavailable. Reload this page and try again."; }
        StateHasChanged();
    }

    private async Task GenerateAsync()
    {
        Password = ""; Status = ""; Error = null;
        if (Type == "random" && !Uppercase && !Lowercase && !Numbers && !Symbols)
        {
            Error = "Select at least one character type.";
            return;
        }
        if (Module is null) return;
        try { Password = await Module.InvokeAsync<string>("generate", Type, Type == "memorable" ? WordCount : Length, Type == "memorable" ? CapitalizeWords : Uppercase, Lowercase, Type == "memorable" ? IncludeNumber : Numbers, Symbols, Separator); }
        catch (JSException) { Error = "Could not generate a password. Check your settings and try again."; }
    }

    private async Task CopyAsync()
    {
        if (string.IsNullOrEmpty(Password)) return;
        try { Status = await JS.InvokeAsync<bool>("copyToClipboard", Password) ? "Password copied." : "Could not copy. Select and copy the password manually."; }
        catch (JSException) { Status = "Clipboard access is unavailable. Select and copy the password manually."; }
    }

    public async ValueTask DisposeAsync()
    {
        try { if (Module is not null) await Module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
