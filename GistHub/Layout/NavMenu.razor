<section class="workspace-ribbon" aria-label="Workspace toolbar">
    <div class="workspace-tab-row">
    <div class="workspace-tabs" role="tablist" aria-label="Workspace commands">
        @foreach (var tab in Tabs)
        {
            <button @ref="TabButtons[tab]" data-testid="@(tab == "Tools" ? "tools-trigger" : null)" id="@($"workspace-tab-{tab}")" role="tab" type="button"
                    aria-selected="@(SelectedTab == tab ? "true" : "false")" aria-controls="workspace-commands"
                    tabindex="@(SelectedTab == tab ? 0 : -1)" @onclick="() => { SelectedTab = tab; IsCollapsed = false; }">@tab</button>
        }
    </div>
        <button type="button" class="ribbon-toggle" aria-controls="workspace-commands" aria-expanded="@(!IsCollapsed ? "true" : "false")"
                aria-label="@(IsCollapsed ? "Expand ribbon" : "Collapse ribbon")" title="@(IsCollapsed ? "Expand ribbon" : "Collapse ribbon")"
                @onclick="() => IsCollapsed = !IsCollapsed">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 15 6-6 6 6"/></svg>
        </button>
    </div>
    <div id="workspace-commands" role="tabpanel" aria-labelledby="@($"workspace-tab-{SelectedTab}")" class="workspace-commands" hidden="@IsCollapsed">
        <div class="workspace-command-area">
        @switch (SelectedTab)
        {
            case "Home":
                <div class="workspace-command-group" aria-label="Collection">
                    <NavLink href="my-gists"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" fill="hsl(var(--secondary))"/><path d="M7 8h10M7 12h10M7 16h6"/></svg><span>My Collection</span></NavLink><NavLink href="editor"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h10l4 4v14H5z" fill="hsl(var(--secondary))"/><path d="M14 3v5h5M8 13h8M12 9v8"/></svg><span>New Snippet</span></NavLink>
                    <NavLink href="collections"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" fill="hsl(var(--secondary))"/><path d="M7 8h10M7 12h10M7 16h6"/></svg><span>Playlists</span></NavLink><NavLink href="slh-collection"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h8l2 3h10l-3 11H2z" fill="hsl(var(--secondary))"/><path d="M2 9h20"/></svg><span>SLH Collection</span></NavLink>
                </div>
                break;
            case "Discover":
                <div class="workspace-command-group" aria-label="Explore">
                    <NavLink href="discovery"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" fill="hsl(var(--secondary))"/><path d="m16 8-2 6-6 2 2-6z"/></svg><span>Discovery</span></NavLink><NavLink href="trending"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18M5 16l5-6 4 3 6-9M15 4h5v5" fill="none"/></svg><span>Trending Now</span></NavLink>
                </div>
                break;
            case "Tools":
                <div class="ribbon-tool-group" role="group" aria-label="Getting started">
                    <div class="ribbon-tool-items workspace-command-group">
                        <button type="button" @ref='ToolTriggers["AI Tools & Skills"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("AI Tools & Skills", ToolTriggers["AI Tools & Skills"]))' class="ribbon-tool" title="AI Tools &amp; Skills" data-testid="agent-skills-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">AI</span>
                            <span>AI Tools &amp; Skills</span>
                        </button>
                        <button type="button" @ref='ToolTriggers["Tools Guide"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Tools Guide", ToolTriggers["Tools Guide"]))' class="ribbon-tool" title="Tools Guide" data-testid="tools-guide-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">?</span>
                            <span>Tools Guide</span>
                        </button>
                    </div>
                </div>
                break;
            case "Data":
                <div class="ribbon-tool-group" role="group" aria-label="Data & encoding">
                    <div class="ribbon-tool-items workspace-command-group">
                        <button data-testid="json-parser-menu-item"
                                @ref='ToolTriggers["JSON Parser"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("JSON Parser", ToolTriggers["JSON Parser"]))'
                                class="ribbon-tool" title="JSON Parser"
                                type="button">
                            <span class="ribbon-tool-icon">
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1"/><path d="M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1"/></svg>
                            </span>
                            <span>JSON Parser</span>
                        </button>
                        <button type="button" @ref='ToolTriggers["JSON to Table"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("JSON to Table", ToolTriggers["JSON to Table"]))' class="ribbon-tool" title="JSON to Table" data-testid="json-to-table-menu-item">
                            <span class="ribbon-tool-icon">
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 9v12M3 15h18"/></svg>
                            </span>
                            <span>JSON to Table</span>
                        </button>
                        <button data-testid="base64-menu-item" @ref='ToolTriggers["Base64 Encode / Decode"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Base64 Encode / Decode", ToolTriggers["Base64 Encode / Decode"]))' class="ribbon-tool" title="Base64 Encode / Decode" type="button">
                            <span class="ribbon-tool-icon" aria-hidden="true">64</span>
                            <span>Base64 Encode / Decode</span>
                        </button>
                    </div>
                </div>
                break;
            case "Markdown":
                <div class="ribbon-tool-group" role="group" aria-label="Markdown & documents">
                    <div class="ribbon-tool-items workspace-command-group">
                        <button type="button" @ref='ToolTriggers["Markdown Live Preview"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Markdown Live Preview", ToolTriggers["Markdown Live Preview"]))' class="ribbon-tool" title="Markdown Live Preview" data-testid="markdown-live-preview-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">MD</span>
                            <span>Markdown Live Preview</span>
                        </button>
                        <button type="button" @ref='ToolTriggers["Markdown to DOCX"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Markdown to DOCX", ToolTriggers["Markdown to DOCX"]))' class="ribbon-tool" title="Markdown to DOCX" data-testid="markdown-docx-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">W</span>
                            <span>Markdown to DOCX</span>
                        </button>
                        <button type="button" @ref='ToolTriggers["Markdown to Cards"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Markdown to Cards", ToolTriggers["Markdown to Cards"]))' class="ribbon-tool" title="Markdown to Cards" data-testid="markdown-cards-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">&#9636;</span>
                            <span>Markdown to Cards</span>
                        </button>
                        <button type="button" @ref='ToolTriggers["Markdown to Text"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Markdown to Text", ToolTriggers["Markdown to Text"]))' class="ribbon-tool" title="Markdown to Text" data-testid="markdown-text-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">T</span>
                            <span>Markdown to Text</span>
                        </button>
                    </div>
                </div>
                break;
            case "Diagrams":
                <div class="ribbon-tool-group" role="group" aria-label="Diagrams & math">
                    <div class="ribbon-tool-items workspace-command-group">
                        <button type="button" @ref='ToolTriggers["draw.io Diagram Editor"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("draw.io Diagram Editor", ToolTriggers["draw.io Diagram Editor"]))' class="ribbon-tool" title="draw.io Diagram Editor" data-testid="diagram-editor-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">&#9671;</span>
                            <span>draw.io Diagram Editor</span>
                        </button>
                        <button type="button" @ref='ToolTriggers["Mermaid to Image"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Mermaid to Image", ToolTriggers["Mermaid to Image"]))' class="ribbon-tool" title="Mermaid to Image" data-testid="mermaid-image-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">&#9671;</span>
                            <span>Mermaid to Image</span>
                        </button>
                        <button type="button" @ref='ToolTriggers["Formula to Image"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Formula to Image", ToolTriggers["Formula to Image"]))' class="ribbon-tool" title="Formula to Image" data-testid="formula-image-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">&#8721;</span>
                            <span>Formula to Image</span>
                        </button>
                    </div>
                </div>
                break;
            case "Media":
                <div class="ribbon-tool-group" role="group" aria-label="Images & media">
                    <div class="ribbon-tool-items workspace-command-group">
                        <button type="button" @ref='ToolTriggers["HTML to Image"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("HTML to Image", ToolTriggers["HTML to Image"]))' class="ribbon-tool" title="HTML to Image" data-testid="html-image-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">&lt;/&gt;</span>
                            <span>HTML to Image</span>
                        </button>
                        <button data-testid="code-image-menu-item"
                                @ref='ToolTriggers["Markdown + Code Converter"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Markdown + Code Converter", ToolTriggers["Markdown + Code Converter"]))'
                                class="ribbon-tool" title="Markdown + Code Converter"
                                type="button">
                            <span class="ribbon-tool-icon">
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 9-3 3 3 3"/><path d="m15 9 3 3-3 3"/></svg>
                            </span>
                            <span>Markdown + Code Converter</span>
                        </button>
                        @if (!IsVercelApp)
                        {
                            <button type="button" @ref='ToolTriggers["YouTube Downloader"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("YouTube Downloader", ToolTriggers["YouTube Downloader"]))' class="ribbon-tool" title="YouTube Downloader" data-testid="youtube-downloader-menu-item">
                                <span class="ribbon-tool-icon" aria-hidden="true">&#9654;</span>
                                <span>YouTube Downloader</span>
                            </button>
                        }
                    </div>
                </div>
                break;
            case "View":
                <div class="workspace-command-group" aria-label="Preferences">
                    <button type="button" @ref='ToolTriggers["Local settings"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Local settings", ToolTriggers["Local settings"]))'><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 17h16M8 4v6M16 14v6"/></svg><span>Local settings</span></button><div class="ribbon-setting"><ThemeToggle /><span>Appearance</span></div><div class="ribbon-setting"><SoundToggle /><span>Sound</span></div>
                </div>
                break;
        }
        </div>
    </div>
</section>


@code {
    private static readonly string[] Tabs = ["Home", "Discover", "Tools", "Data", "Markdown", "Diagrams", "Media", "View"];
    private string SelectedTab = "Home";
    private bool IsCollapsed;
    private readonly Dictionary<string, ElementReference> TabButtons = new();
    private readonly Dictionary<string, ElementReference> ToolTriggers = new();
    [Parameter] public EventCallback<(string Name, ElementReference Trigger)> OnOpenWorkbenchTool { get; set; }
    [Parameter] public bool IsVercelApp { get; set; }
    public ValueTask FocusToolsAsync() => TabButtons["Tools"].FocusAsync();

}
