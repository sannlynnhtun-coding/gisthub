<section class="workspace-ribbon" aria-label="Workspace toolbar">
    <div class="workspace-tabs" role="tablist" aria-label="Workspace commands">
        @foreach (var tab in Tabs)
        {
            <button @ref="TabButtons[tab]" data-testid="@(tab == "Tools" ? "tools-trigger" : null)" id="@($"workspace-tab-{tab}")" role="tab" type="button"
                    aria-selected="@(SelectedTab == tab ? "true" : "false")" aria-controls="workspace-commands"
                    tabindex="@(SelectedTab == tab ? 0 : -1)" @onclick="() => SelectedTab = tab">@tab</button>
        }
    </div>
    <div id="workspace-commands" role="tabpanel" aria-labelledby="@($"workspace-tab-{SelectedTab}")" class="workspace-commands">
        <div class="workspace-command-area">
        @switch (SelectedTab)
        {
            case "Home":
                <div class="workspace-command-group" aria-label="Collection">
                    <NavLink href="my-gists"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" fill="hsl(var(--secondary))"/><path d="M7 8h10M7 12h10M7 16h6"/></svg><span>My Collection</span></NavLink><NavLink href="editor"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h10l4 4v14H5z" fill="hsl(var(--secondary))"/><path d="M14 3v5h5M8 13h8M12 9v8"/></svg><span>New Snippet</span></NavLink>
                    <NavLink href="collections"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" fill="hsl(var(--secondary))"/><path d="M7 8h10M7 12h10M7 16h6"/></svg><span>Playlists</span></NavLink><NavLink href="slh-collection"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h8l2 3h10l-3 11H2z" fill="hsl(var(--secondary))"/><path d="M2 9h20"/></svg><span>SLH Collection</span></NavLink>
                </div>
                break;
            case "Discover":
                <div class="workspace-command-group" aria-label="Explore">
                    <NavLink href="discovery"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" fill="hsl(var(--secondary))"/><path d="m16 8-2 6-6 2 2-6z"/></svg><span>Discovery</span></NavLink><NavLink href="trending"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18M5 16l5-6 4 3 6-9M15 4h5v5" fill="none"/></svg><span>Trending Now</span></NavLink>
                </div>
                break;
            case "Tools":
                <div class="ribbon-tool-group" role="group" aria-label="Getting started">
                    <div class="ribbon-tool-items">
                        <a href="agent-skills" class="ribbon-tool" title="AI Tools &amp; Skills" data-testid="agent-skills-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">AI</span>
                            <span>AI Tools &amp; Skills</span>
                        </a>
                        <a href="tools" class="ribbon-tool" title="Tools Guide" data-testid="tools-guide-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">?</span>
                            <span>Tools Guide</span>
                        </a>
                    </div>
                    <span class="ribbon-group-label">Getting started</span>
                </div>
                break;
            case "Data":
                <div class="ribbon-tool-group" role="group" aria-label="Data & encoding">
                    <div class="ribbon-tool-items">
                        <button data-testid="json-parser-menu-item"
                                @ref='ToolTriggers["JSON Parser"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("JSON Parser", ToolTriggers["JSON Parser"]))'
                                class="ribbon-tool" title="JSON Parser"
                                type="button">
                            <span class="ribbon-tool-icon">
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1"/><path d="M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1"/></svg>
                            </span>
                            <span>JSON Parser</span>
                        </button>
                        <button type="button" @ref='ToolTriggers["JSON to Table"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("JSON to Table", ToolTriggers["JSON to Table"]))' class="ribbon-tool" title="JSON to Table" data-testid="json-to-table-menu-item">
                            <span class="ribbon-tool-icon">
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 9v12M3 15h18"/></svg>
                            </span>
                            <span>JSON to Table</span>
                        </button>
                        <button data-testid="base64-menu-item" @ref='ToolTriggers["Base64 Encode / Decode"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Base64 Encode / Decode", ToolTriggers["Base64 Encode / Decode"]))' class="ribbon-tool" title="Base64 Encode / Decode" type="button">
                            <span class="ribbon-tool-icon" aria-hidden="true">64</span>
                            <span>Base64 Encode / Decode</span>
                        </button>
                    </div>
                    <span class="ribbon-group-label">Data & encoding</span>
                </div>
                break;
            case "Markdown":
                <div class="ribbon-tool-group" role="group" aria-label="Markdown & documents">
                    <div class="ribbon-tool-items">
                        <a href="tools/markdown-live-preview" class="ribbon-tool" title="Markdown Live Preview" data-testid="markdown-live-preview-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">MD</span>
                            <span>Markdown Live Preview</span>
                        </a>
                        <a href="tools/markdown-to-docx" class="ribbon-tool" title="Markdown to DOCX" data-testid="markdown-docx-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">W</span>
                            <span>Markdown to DOCX</span>
                        </a>
                        <a href="tools/markdown-to-cards" class="ribbon-tool" title="Markdown to Cards" data-testid="markdown-cards-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">&#9636;</span>
                            <span>Markdown to Cards</span>
                        </a>
                        <a href="tools/markdown-to-text" class="ribbon-tool" title="Markdown to Text" data-testid="markdown-text-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">T</span>
                            <span>Markdown to Text</span>
                        </a>
                    </div>
                    <span class="ribbon-group-label">Markdown & documents</span>
                </div>
                break;
            case "Diagrams":
                <div class="ribbon-tool-group" role="group" aria-label="Diagrams & math">
                    <div class="ribbon-tool-items">
                        <a href="tools/diagram-editor" class="ribbon-tool" title="draw.io Diagram Editor" data-testid="diagram-editor-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">&#9671;</span>
                            <span>draw.io Diagram Editor</span>
                        </a>
                        <a href="tools/mermaid-to-image" class="ribbon-tool" title="Mermaid to Image" data-testid="mermaid-image-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">&#9671;</span>
                            <span>Mermaid to Image</span>
                        </a>
                        <a href="tools/formula-to-image" class="ribbon-tool" title="Formula to Image" data-testid="formula-image-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">&#8721;</span>
                            <span>Formula to Image</span>
                        </a>
                    </div>
                    <span class="ribbon-group-label">Diagrams & math</span>
                </div>
                break;
            case "Media":
                <div class="ribbon-tool-group" role="group" aria-label="Images & media">
                    <div class="ribbon-tool-items">
                        <a href="tools/html-to-image" class="ribbon-tool" title="HTML to Image" data-testid="html-image-menu-item">
                            <span class="ribbon-tool-icon" aria-hidden="true">&lt;/&gt;</span>
                            <span>HTML to Image</span>
                        </a>
                        <button data-testid="code-image-menu-item"
                                @ref='ToolTriggers["Markdown + Code Converter"]' @onclick='() => OnOpenWorkbenchTool.InvokeAsync(("Markdown + Code Converter", ToolTriggers["Markdown + Code Converter"]))'
                                class="ribbon-tool" title="Markdown + Code Converter"
                                type="button">
                            <span class="ribbon-tool-icon">
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 9-3 3 3 3"/><path d="m15 9 3 3-3 3"/></svg>
                            </span>
                            <span>Markdown + Code Converter</span>
                        </button>
                        @if (!IsVercelApp)
                        {
                            <a href="tools/youtube-downloader" class="ribbon-tool" title="YouTube Downloader" data-testid="youtube-downloader-menu-item">
                                <span class="ribbon-tool-icon" aria-hidden="true">&#9654;</span>
                                <span>YouTube Downloader</span>
                            </a>
                        }
                    </div>
                    <span class="ribbon-group-label">Images & media</span>
                </div>
                break;
            case "View":
                <div class="workspace-command-group" aria-label="Preferences">
                    <NavLink href="settings"><svg class="ribbon-command-icon" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 17h16M8 4v6M16 14v6"/></svg><span>Local settings</span></NavLink><div class="ribbon-setting"><ThemeToggle /><span>Appearance</span></div><div class="ribbon-setting"><SoundToggle /><span>Sound</span></div>
                </div>
                break;
        }
        </div>
        <div class="workspace-account">
            @if (AppState.IsAuthenticated)
            {
                <div class="neo-profile-card p-3 bg-secondary rounded-lg border border-border animate-in fade-in slide-in-from-bottom-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-muted flex items-center justify-center overflow-hidden border border-border">
                            <img src="@($"https://github.com/{AppState.CurrentProfile?.GithubUsername}.png")" class="w-full h-full object-cover" onerror="this.src='https://github.com/identicons/slh.png'" />
                        </div>
                        <div class="flex flex-col min-w-0">
                            <span class="text-sm font-semibold truncate leading-tight">@AppState.CurrentProfile?.Name</span>
                            <span class="text-[10px] text-primary/70 truncate font-mono">@@@AppState.CurrentProfile?.GithubUsername</span>
                        </div>
                        <button @onclick="ShowLogoutConfirm" class="ml-auto p-1 hover:bg-destructive/10 text-muted-foreground hover:text-destructive rounded-md transition-all" title="Sign out" aria-label="Sign out">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-out"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <NavLink href="login" class="neo-profile-card p-3 bg-secondary/50 rounded-lg border border-border flex items-center gap-3 hover:bg-secondary transition-all group">
                    <div class="w-8 h-8 rounded-lg bg-muted flex items-center justify-center overflow-hidden border border-border">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-2 text-muted-foreground"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-sm font-semibold truncate leading-tight">Guest Account</span>
                        <span class="text-[10px] text-muted-foreground truncate underline decoration-dotted">Sign In Required</span>
                    </div>
                </NavLink>
            }
        </div>
    </div>
</section>
@if (IsLogoutConfirmOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 md:p-6">
        <button class="absolute inset-0 bg-black/40 backdrop-blur-sm cursor-default" aria-label="Cancel sign out" @onclick="CloseLogoutConfirm"></button>
        <div class="relative w-full max-w-md bg-card border border-border rounded-xl p-5 space-y-5" role="dialog" aria-modal="true" aria-labelledby="logout-confirm-title">
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-lg bg-destructive/5 text-destructive flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-out"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                </div>
                <div class="space-y-1">
                    <h2 id="logout-confirm-title" class="text-xl font-semibold tracking-tight">Sign out?</h2>
                    <p class="text-sm text-muted-foreground">Are you sure you want to sign out of your account?</p>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2">
                <button @onclick="CloseLogoutConfirm" class="btn btn-outline btn-md">Cancel</button>
                <button @onclick="ConfirmLogout" class="btn btn-destructive btn-md">Sign out</button>
            </div>
        </div>
    </div>
}

@implements IDisposable
@inject AppState AppState
@inject NavigationManager Navigation

@code {
    private static readonly string[] Tabs = ["Home", "Discover", "Tools", "Data", "Markdown", "Diagrams", "Media", "View"];
    private string SelectedTab = "Home";
    private bool IsLogoutConfirmOpen;
    private readonly Dictionary<string, ElementReference> TabButtons = new();
    private readonly Dictionary<string, ElementReference> ToolTriggers = new();
    [Parameter] public EventCallback<(string Name, ElementReference Trigger)> OnOpenWorkbenchTool { get; set; }
    [Parameter] public bool IsVercelApp { get; set; }
    public ValueTask FocusToolsAsync() => TabButtons["Tools"].FocusAsync();

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ShowLogoutConfirm()
    {
        IsLogoutConfirmOpen = true;
    }

    private void CloseLogoutConfirm()
    {
        IsLogoutConfirmOpen = false;
    }

    private void ConfirmLogout()
    {
        IsLogoutConfirmOpen = false;
        AppState.SetProfile(null);
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

