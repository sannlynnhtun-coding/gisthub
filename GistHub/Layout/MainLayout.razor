@inherits LayoutComponentBase
@implements IAsyncDisposable

<div class="neo-app-shell relative min-h-screen flex bg-background text-foreground @(AreFilesBlurred ? "gist-files-blurred" : "")"
     aria-hidden="@(IsModalOpen ? "true" : null)"
     inert="@(IsModalOpen ? "" : null)">

    <main class="neo-main flex-1 flex flex-col min-w-0 h-screen overflow-hidden">
        <header class="neo-topbar excel-topbar flex items-center justify-between px-6 glass sticky top-0 z-40">
            <div class="neo-topbar-brand flex items-center gap-4">
                <a href="my-gists" aria-label="GistHub â€” My Collection" class="neo-brand-mark w-9 h-9 overflow-hidden rounded-md">
                    <img src="logo.svg" class="w-full h-full object-cover" alt="" />
                </a>
                <div>
                    <div class="neo-kicker mb-1">Code stash</div>
                    <h1 class="text-xl font-black tracking-tight"><a href="my-gists" aria-label="GistHub â€” My Collection">GistHub</a></h1>
                </div>
            </div>

            <div class="excel-workspace-title">Local workspace</div>
            <div class="neo-topbar-actions flex items-center gap-3">
                <NavLink href="editor" class="neo-new-snippet btn btn-primary btn-md" title="Create a new snippet" aria-label="New snippet">
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                    <span class="neo-new-snippet__label" aria-hidden="true">New Snippet</span>
                </NavLink>
                <LocalBackupReminder />
                <UpdateNotifications />
                <SectionOutlet SectionName="collection-actions" />
                <button data-testid="global-search-trigger"
                        data-global-search-trigger
                        data-shortcut-ready="@(IsSearchShortcutReady ? "true" : "false")"
                        @ref="GlobalSearchTrigger"
                        @onclick="OpenGlobalSearch"
                        class="neo-topbar-search neo-icon-button"
                        type="button"
                        title="Search cached gists (Ctrl+K)"
                        aria-label="Search cached gists"
                        aria-haspopup="dialog"
                        aria-expanded="@IsGlobalSearchOpen">
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </button>

                <button data-testid="blur-files-trigger"
                        @onclick="ToggleFileBlurAsync"
                        class="neo-topbar-bookmarks neo-icon-button @(AreFilesBlurred ? "is-active" : "")"
                        type="button"
                        aria-label="Blur Files"
                        aria-pressed="@(AreFilesBlurred ? "true" : "false")"
                        title="@(AreFilesBlurred ? "Show file previews" : "Blur file previews")">
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>@if (AreFilesBlurred) { <path d="M3 21 21 3"/> }</svg>
                </button>
                <ProfileMenu />
            </div>
        </header>
        <NavMenu @ref="WorkspaceNavigation" OnOpenWorkbenchTool="OpenWorkbenchTool" IsVercelApp="IsVercelApp" />

        <div class="neo-canvas flex-1 overflow-y-auto p-6 md:p-10 custom-scrollbar @(IsToolWorkspaceVisible ? "neo-canvas--tool" : "")">
            <div class="neo-decor neo-decor--pink" aria-hidden="true"></div>
            <div class="neo-decor neo-decor--purple" aria-hidden="true"></div>
            @if (IsProfileReady && !ProfileLoadFailed)
            {
                <ToolWorkspace ActiveTool="@(IsUtilityOpen ? null : ActivePageTool)" OnBack="BackFromTool" OnOpenWorkbenchTool="OpenWorkbenchTool" FocusOnOpen="@(!ShouldRestoreToolsFocus)" />
            }
            <div hidden="@IsToolWorkspaceVisible" class="neo-content max-w-6xl mx-auto space-y-10 animate-in fade-in duration-500">
                @if (!IsProfileReady)
                {
                    <p role="status">Loading your local workspaceâ€¦</p>
                }
                else if (ProfileLoadFailed)
                {
                    <div role="alert">
                        <p>Could not open your local workspace. Your cached data has not been cleared.</p>
                        <button class="btn btn-secondary btn-md" @onclick="LoadProfileAsync">Retry</button>
                    </div>
                }
                else
                {
                    <CascadingValue Name="OpenWorkbenchTool" Value="OpenWorkbenchTool">
                        @if (RoutedTool is null) { @Body }
                    </CascadingValue>
                }
            </div>
        </div>
    </main>
</div>

<GlobalGistSearch IsOpen="@IsGlobalSearchOpen"
                  IsAuthenticated="@AppState.IsAuthenticated"
                  AccountUsername="@(AppState.CurrentProfile?.GithubUsername ?? string.Empty)"
                  OnClose="CloseGlobalSearch"
                  OnSelectGist="OpenGistFromSearch" />
<JsonParserOverlay IsOpen="@IsJsonParserOpen" OnClose="CloseJsonParser" />
<Base64Overlay IsOpen="@IsBase64Open" OnClose="CloseBase64" />
<JsonTableOverlay IsOpen="@IsJsonTableOpen" OnClose="CloseJsonTable" />
<CodeImageOverlay IsOpen="@IsCodeImageOpen" OnClose="CloseCodeImage" />


@inject AppState AppState
@inject IStorageService Storage
@inject IJSRuntime JS
@inject NavigationManager Navigation

@code {
    private const string FilesBlurredStorageKey = "gisthub:files-blurred";

    private bool IsProfileReady;
    private bool ProfileLoadFailed;
    private bool AreFilesBlurred { get; set; }
    private bool IsVercelApp => new Uri(Navigation.BaseUri).Host is var host &&
        (host.Equals("vercel.app", StringComparison.OrdinalIgnoreCase) || host.EndsWith(".vercel.app", StringComparison.OrdinalIgnoreCase));
    private bool IsGlobalSearchOpen { get; set; }
    private bool IsSearchShortcutReady { get; set; }
    private bool IsJsonParserOpen { get; set; }
    private bool IsBase64Open { get; set; }
    private bool IsJsonTableOpen { get; set; }
    private bool IsCodeImageOpen { get; set; }
    private bool ShouldRestoreToolsFocus { get; set; }
    private bool ShouldRestoreSearchFocus { get; set; }
    private NavMenu? WorkspaceNavigation;
    private ElementReference GlobalSearchTrigger { get; set; }
    private ElementReference? GuideToolTrigger;
    private EventCallback<(string Name, ElementReference Trigger)> OpenWorkbenchTool =>
        EventCallback.Factory.Create<(string Name, ElementReference Trigger)>(this, OpenToolFromGuide);
    private IJSObjectReference? AppShellModule { get; set; }
    private bool IsUtilityOpen => IsJsonParserOpen || IsCodeImageOpen || IsBase64Open || IsJsonTableOpen;
    private readonly List<(string Name, ElementReference? Trigger)> PageToolHistory = new();
    private string? ActivePageTool => PageToolHistory.Count > 0 ? PageToolHistory[^1].Name : null;
    private string? RoutedTool => ToolWorkspace.Pages.FirstOrDefault(tool => tool.Value.Route == Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/')).Key;
    private bool IsToolWorkspaceVisible => IsProfileReady && !ProfileLoadFailed && ActivePageTool is not null;
    private bool IsModalOpen => IsUtilityOpen || IsGlobalSearchOpen;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        if (RoutedTool is { } tool) PageToolHistory.Add((tool, null));
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        IsProfileReady = false;
        ProfileLoadFailed = false;
        try
        {
            if (!AppState.IsAuthenticated)
            {
                var profiles = await Storage.GetProfilesAsync();
                if (profiles is { Count: > 0 })
                {
                    AppState.SetProfile(profiles.First());
                }
            }
        }
        catch (Exception)
        {
            ProfileLoadFailed = true;
        }
        finally
        {
            IsProfileReady = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var storedBlur = await JS.InvokeAsync<string?>("localStorage.getItem", FilesBlurredStorageKey);
            AreFilesBlurred = string.Equals(storedBlur, "true", StringComparison.OrdinalIgnoreCase);

            AppShellModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/appShell.js");
            await AppShellModule.InvokeVoidAsync("registerGlobalSearchShortcut");
            IsSearchShortcutReady = true;
            StateHasChanged();
        }

        if (ShouldRestoreToolsFocus)
        {
            ShouldRestoreToolsFocus = false;
            var trigger = GuideToolTrigger;
            GuideToolTrigger = null;
            // Ribbon commands can unmount while a tool is open.
            var restored = trigger is { } element && AppShellModule is not null &&
                await AppShellModule.InvokeAsync<bool>("tryFocus", element);
            if (!restored && WorkspaceNavigation is not null) await WorkspaceNavigation.FocusToolsAsync();
        }

        if (ShouldRestoreSearchFocus)
        {
            ShouldRestoreSearchFocus = false;
            await GlobalSearchTrigger.FocusAsync();
        }
    }

    private async Task ToggleFileBlurAsync()
    {
        AreFilesBlurred = !AreFilesBlurred;
        await JS.InvokeVoidAsync("gistHubBackup.setPreference", FilesBlurredStorageKey, AreFilesBlurred ? "true" : "false");
    }

    private void OpenGlobalSearch()
    {
        if (IsUtilityOpen)
        {
            return;
        }

        IsGlobalSearchOpen = true;
    }

    private void CloseGlobalSearch()
    {
        IsGlobalSearchOpen = false;
        ShouldRestoreSearchFocus = true;
    }

    private void OpenGistFromSearch(string gistId)
    {
        IsGlobalSearchOpen = false;
        Navigation.NavigateTo($"/view/{Uri.EscapeDataString(gistId)}");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        GuideToolTrigger = null;
        PageToolHistory.Clear();
        if (RoutedTool is { } tool) PageToolHistory.Add((tool, null));
        _ = InvokeAsync(StateHasChanged);
    }

    private void OpenToolFromGuide((string Name, ElementReference Trigger) tool)
    {
        GuideToolTrigger = tool.Trigger;
        switch (tool.Name)
        {
            case "JSON Parser": OpenJsonParser(); break;
            case "JSON to Table": OpenJsonTable(); break;
            case "Base64 Encode / Decode": OpenBase64(); break;
            case "Markdown + Code Converter": OpenCodeImage(); break;
            default:
                if (ToolWorkspace.Pages.ContainsKey(tool.Name) && tool.Name != ActivePageTool)
                    PageToolHistory.Add((tool.Name, tool.Trigger));
                break;
        }
    }

    private void BackFromTool()
    {
        if (PageToolHistory.Count == 0) return;
        GuideToolTrigger = PageToolHistory[^1].Trigger;
        PageToolHistory.RemoveAt(PageToolHistory.Count - 1);
        ShouldRestoreToolsFocus = true;
        if (ActivePageTool is null && RoutedTool is not null) Navigation.NavigateTo("discovery");
    }

    private void OpenJsonParser()
    {
        IsJsonParserOpen = true;
    }

    private void CloseJsonParser()
    {
        IsJsonParserOpen = false;
        ShouldRestoreToolsFocus = true;
    }

    private void OpenBase64()
    {
        IsBase64Open = true;
    }

    private void OpenJsonTable()
    {
        IsJsonTableOpen = true;
    }

    private void CloseJsonTable()
    {
        IsJsonTableOpen = false;
        ShouldRestoreToolsFocus = true;
    }

    private void CloseBase64()
    {
        IsBase64Open = false;
        ShouldRestoreToolsFocus = true;
    }

    private void OpenCodeImage()
    {
        IsCodeImageOpen = true;
    }

    private void CloseCodeImage()
    {
        IsCodeImageOpen = false;
        ShouldRestoreToolsFocus = true;
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;

        if (AppShellModule is not null)
        {
            try
            {
                await AppShellModule.InvokeVoidAsync("unregisterGlobalSearchShortcut");
                await AppShellModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

    }
}
